# ===========================================
# FathomNet 2025 - Final Branch .gitignore
# ===========================================
# This branch contains all code, checkpoints, and submissions
# for reproducing the experiments. Datasets must be downloaded
# separately using the provided scripts.

# -------------------------------------------
# DATA DIRECTORIES (download separately)
# -------------------------------------------
# Training/test images - use download.py to fetch
/train/
/test/
/train_full/
/train_corrupted/

# -------------------------------------------
# REPORTS (excluded from this branch)
# -------------------------------------------
/report/

# -------------------------------------------
# DOCS (local planning/notes only)
# -------------------------------------------
docs/*.md

# -------------------------------------------
# PYTHON
# -------------------------------------------
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.eggs/

# -------------------------------------------
# LOGS (regenerated during training)
# -------------------------------------------
*.log
nohup*.out
*.out

# -------------------------------------------
# ENVIRONMENT
# -------------------------------------------
.env
.venv/
venv/
env/

# -------------------------------------------
# IDE/TOOLS
# -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -------------------------------------------
# OS FILES
# -------------------------------------------
.DS_Store
Thumbs.db

# -------------------------------------------
# LARGE INTERMEDIATE FILES
# -------------------------------------------
# These are auto-generated and can be recreated
outputs/*/train.log
outputs/lightning_logs/

# -------------------------------------------
# TEMP FILES
# -------------------------------------------
*.tmp
*.temp

# -------------------------------------------
# LARGE CHECKPOINT FILES (>2GB, exceeds GitHub LFS limit)
# -------------------------------------------
# The main model checkpoints are too large for GitHub.
# Download from Google Drive:
#   - multiscale_4scales (val_loss=0.864):
#     https://drive.google.com/open?id=1F147aOE3cvgQWTHeNhx4CE2eAmOacDim
#   - multiscale_4scales_taxloss (val_tax_score=0.531, Private LB: 1.94):
#     https://drive.google.com/open?id=1roOwrSRXP93tZRiLqb4paKrmBnT4Jw1y
# Or train from scratch using the provided scripts.
outputs/*/checkpoints/*.ckpt

# Keep legacy checkpoint (under 2GB limit)
!legacy/*.ckpt
